generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
}

enum VoteType {
  UP
  DOWN
}

enum FlagStatus {
  PENDING
  REVIEWED
  DISMISSED
  REMOVED
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  role              Role
  detectedBatch     String?
  isEmailVerified   Boolean         @default(false)
  isProfileComplete Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  rollNumber  String   @unique
  branch      String
  batch       String   // e.g. "BE24"
  yearOfStudy Int      // 1, 2, 3, 4
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id          String            @id @default(uuid())
  userId      String            @unique
  fullName    String
  department  String
  designation String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerings   CourseOffering[]
}

model CourseOffering {
  id           String         @id @default(uuid())
  teacherId    String
  courseCode   String         // e.g. "UCS405"
  courseName   String         // e.g. "Discrete Mathematics"
  batchTaught  String         // e.g. "BE24"
  branchTaught String         // e.g. "COE"
  academicYear String         // e.g. "2024-2025"
  createdAt    DateTime       @default(now())

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Review {
  reviewId        Int          @id @default(autoincrement())
  reviewerId      String
  reviewerRollNo  String?
  reviewerBatch   String?
  reviewerBranch  String?
  revieweeId      String
  courseCode      String?
  courseName      String?
  rating          Int
  reviewText      String
  context         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  isFlagged       Boolean      @default(false)

  votes           ReviewVote[]
  flags           ReviewFlag[]
  replies         ReviewReply[]
}

model ReviewVote {
  voteId    Int      @id @default(autoincrement())
  reviewId  Int
  userId    String
  voteType  VoteType
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model ReviewFlag {
  flagId     Int        @id @default(autoincrement())
  reviewId   Int
  reporterId String
  reason     String
  status     FlagStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  review     Review     @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
}

model ReviewReply {
  replyId        Int      @id @default(autoincrement())
  reviewId       Int
  authorId       String
  authorRole     Role
  authorName     String
  authorBadge    String?
  replyText      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  review         Review   @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
}

model ProfileRating {
  ratingId       Int      @id @default(autoincrement())
  userId         String   @unique
  overallRating  Float
  recentRating   Float
  totalReviews   Int
  calculatedAt   DateTime @default(now())
}
