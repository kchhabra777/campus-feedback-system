generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum VoteType {
  UP
  DOWN
}

enum FlagStatus {
  PENDING
  REVIEWED
  DISMISSED
  REMOVED
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  passwordHash      String
  role              Role
  detectedBatch     String?
  isEmailVerified   Boolean         @default(false)
  isProfileComplete Boolean         @default(false)
  isBanned          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  studentProfile    StudentProfile?
  teacherProfile    TeacherProfile?
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

model StudentProfile {
  id          String   @id @default(uuid())
  userId      String   @unique
  fullName    String?  // e.g. "Robin Singh"
  rollNumber  String   @unique
  branch      String
  batch       String   // e.g. "3Q11", "2Q12"
  yearOfStudy Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id          String            @id @default(uuid())
  userId      String            @unique
  fullName    String
  department  String
  designation String
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  offerings   CourseOffering[]
}

model CourseOffering {
  id           String         @id @default(uuid())
  teacherId    String
  courseCode   String
  courseName   String
  batchTaught  String         // e.g. "3Q11", "2Q12"
  branchTaught String
  academicYear String
  ltp          String?        @default("L") // L, T, P
  createdAt    DateTime       @default(now())

  teacher      TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model Review {
  reviewId        Int          @id @default(autoincrement())
  reviewerId      String
  reviewerName    String?      // Student Full Name
  reviewerEmail   String?      // Student @thapar.edu Email
  reviewerRollNo  String?      // 10-digit roll number
  reviewerBatch   String?      // e.g. "3Q11"
  reviewerBranch  String?      // e.g. "COE"
  revieweeId      String
  courseCode      String?
  courseName      String?
  rating          Int
  reviewText      String
  context         String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  isFlagged       Boolean      @default(false)

  votes           ReviewVote[]
  flags           ReviewFlag[]
  replies         ReviewReply[]
}

model ReviewVote {
  voteId    Int      @id @default(autoincrement())
  reviewId  Int
  userId    String
  voteType  VoteType
  createdAt DateTime @default(now())

  review    Review   @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)

  @@unique([reviewId, userId])
}

model ReviewFlag {
  flagId     Int        @id @default(autoincrement())
  reviewId   Int
  reporterId String
  reason     String
  status     FlagStatus @default(PENDING)
  createdAt  DateTime   @default(now())

  review     Review     @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
}

model ReviewReply {
  replyId        Int          @id @default(autoincrement())
  reviewId       Int
  authorId       String
  authorRole     Role
  authorName     String
  authorBadge    String?
  replyText      String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  review         Review       @relation(fields: [reviewId], references: [reviewId], onDelete: Cascade)
  votes          ReplyVote[]
}

model ReplyVote {
  voteId    Int      @id @default(autoincrement())
  replyId   Int
  userId    String
  voteType  VoteType
  createdAt DateTime @default(now())

  reply     ReviewReply @relation(fields: [replyId], references: [replyId], onDelete: Cascade)

  @@unique([replyId, userId])
}

model ProfileRating {
  ratingId       Int      @id @default(autoincrement())
  userId         String   @unique
  overallRating  Float
  recentRating   Float
  totalReviews   Int
  calculatedAt   DateTime @default(now())
}
